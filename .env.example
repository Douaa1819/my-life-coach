# Copy this file to .env and fill in the values. Never commit .env.
#
# Everything prefixed with EXPO_PUBLIC_ is compiled into the app and readable
# by anyone who installs it. Only public values belong here.
#
# Supabase dashboard > Project Settings > API:
#   Project URL      -> EXPO_PUBLIC_SUPABASE_URL
#   Publishable key  -> EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY  (starts with sb_publishable_)
# The dashboard's Next.js snippet calls these NEXT_PUBLIC_*; Expo ignores that prefix.
#
# The publishable key is safe in the client only because Row Level Security is
# enabled on every table that holds user data. The app refuses to start with a
# secret (sb_secret_...) or service_role key here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only secrets. Never put these in this file or prefix them with
# EXPO_PUBLIC_. Set them as Supabase Edge Function secrets instead:
#   npx supabase secrets set GEMINI_API_KEY=...
# SUPABASE_SERVICE_ROLE_KEY
# GEMINI_API_KEY
