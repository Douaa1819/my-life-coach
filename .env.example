# Copy this file to .env. Do not commit .env.
#
# Expo inlines only variables whose names start with EXPO_PUBLIC_.
# The Supabase dashboard copies Next.js names. Map them as follows:
#   NEXT_PUBLIC_SUPABASE_URL             -> EXPO_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY -> EXPO_PUBLIC_SUPABASE_ANON_KEY
#
# The publishable key may ship in the client only when Row Level Security
# is enabled on every table that holds user data.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Never put these in the mobile app, and never prefix them with EXPO_PUBLIC_:
# SUPABASE_SERVICE_ROLE_KEY
# GEMINI_API_KEY
